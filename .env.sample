# 使用するAWSプロファイル (未指定時は your-profile)
AWS_PROFILE=your-profile

# Snowflake の接続情報 (Terraform の snowflake provider が使用。infra/env/dev の plan / destroy で必要)
# 秘密鍵のパスは .env ではなく terraform.tfvars の snowflake_private_key_path で指定する
SNOWFLAKE_ORGANIZATION_NAME=YOUR_ORG_NAME
SNOWFLAKE_ACCOUNT_NAME=YOUR_ACCOUNT_NAME
SNOWFLAKE_USER=YOUR_USER_NAME
SNOWFLAKE_AUTHENTICATOR=SNOWFLAKE_JWT
# Terraform が使うロール (ネットワークルール / EAI の作成と DCP の変更ができるもの)
SNOWFLAKE_ROLE=SYSADMIN

# Terraform の state を置く S3 バケット。backend ブロックには変数が使えないため、terraform init に -backend-config を足す。
# infra/env/dev/backend.tfbackend.sample をコピーして backend.tfbackend を作り (コミットしない)、その絶対パスを指定する
TF_CLI_ARGS_init="-backend-config=/absolute/path/to/openflow_aurora/infra/env/dev/backend.tfbackend"
